{
  "name": "monstertrade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "wrangler dev --ip 127.0.0.1",
    "check:deploy": "wrangler deploy --dry-run --env \"\"",
    "check:deploy:staging": "wrangler deploy --dry-run --env staging",
    "deploy": "node scripts/deploy.mjs",
    "db:create": "wrangler d1 create monsterstrade-prices --binding PRICES_DB --update-config",
    "db:migrate:local": "wrangler d1 migrations apply PRICES_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PRICES_DB --remote",
    "check": "node scripts/check.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
