{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monstertrade",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "PRICES_DB",
      "database_name": "monsterstrade-prices",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ratelimits": [
    { "name": "PUBLIC_API_RATE_LIMITER", "namespace_id": "14693313871", "simple": { "limit": 120, "period": 60 } },
    { "name": "PRICE_ADMISSION_RATE_LIMITER", "namespace_id": "14693313872", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "REQUIRE_RATE_LIMITERS": "true",
    "MAX_TRACKED_CARDS": "500",
    "MAX_UPSTREAM_REQUESTS_PER_DAY": "1000",
    "REFRESH_BATCH_SIZE": "2"
  },
  "env": {
    "staging": {
      "name": "monstertrade-staging",
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "none"
      },
      "d1_databases": [
        {
          "binding": "PRICES_DB",
          "database_name": "monsterstrade-prices-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "ratelimits": [
        { "name": "PUBLIC_API_RATE_LIMITER", "namespace_id": "14693313873", "simple": { "limit": 120, "period": 60 } },
        { "name": "PRICE_ADMISSION_RATE_LIMITER", "namespace_id": "14693313874", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "REQUIRE_RATE_LIMITERS": "true",
        "MAX_TRACKED_CARDS": "50",
        "MAX_UPSTREAM_REQUESTS_PER_DAY": "100",
        "REFRESH_BATCH_SIZE": "1"
      }
    }
  }
}
